{
  "name": "mini-hospital",
  "version": "1.0.0",
  "private": true,
  "description": "Mini Hospital - Integrasi Sistem Informasi Pelayanan Pasien dan Farmasi",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:hospital": "npm run dev --workspace=apps/hospital",
    "dev:pharmacy": "npm run dev --workspace=apps/pharmacy",
    "dev": "concurrently -n hospital,pharmacy -c cyan,green \"npm run dev:hospital\" \"npm run dev:pharmacy\"",
    "build:hospital": "npm run build --workspace=apps/hospital",
    "build:pharmacy": "npm run build --workspace=apps/pharmacy",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "check:db:hospital": "npx tsx apps/hospital/check-db.ts",
    "check:db:pharmacy": "npx tsx apps/pharmacy/check-db.ts"
  },
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
